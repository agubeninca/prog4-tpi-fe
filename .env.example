# URLs de desarrollo. Si apuntan a localhost, la app las cambia sola por la IP desde la que se abrió
# (así funciona igual en la PC y en el celular conectado a la misma red WiFi).
VITE_API_URL=http://localhost:3000
# URL que va en los QR de las mesas: npm start la completa con la IP de la red local.
VITE_PUBLIC_APP_URL=http://localhost:5173
# Opcional: forzar la IP de la red que se usa en los QR (si npm start elige un adaptador equivocado).
# KITCH_IP_LAN=192.168.0.10

# Firebase Emulator Suite (proyecto demo-*: no requiere cuenta ni credenciales reales)
VITE_FIREBASE_PROJECT_ID=demo-kitch
VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_STORAGE_EMULATOR_URL=http://127.0.0.1:9199/v0/b/demo-kitch.appspot.com/o
